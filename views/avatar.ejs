<%- include('partials/header') %>
    <div class="container">
        <div class="card text-left">
            <div class="card-header text-center">
                <h1>
                    <%=title%>
                </h1>
            </div>
            <form action="" method="post" encType="multipart/form-data">

                <div class="card-body">
                    <div class="row mb-3">
                        <label for="avatar" class="col-sm-2 col-form-label">avatar</label>
                        <div class="col-sm-10">
                            <input type="file" name="avatar" id="avatar" class="form-control">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="avatar" class="col-sm-2 col-form-label">preview</label>
                        <div class="col-sm-10">
                            <img id="img-avatar" src="/images/avatars/<%= user.avatar ? user.avatar : 'user_image.jpg'%>"
                                alt="avatar" width="500px" height="500px">
                        </div>
                    </div>
                </div>

                <div class="card-footer text-body-secondary">
                    <button type="submit" class="btn btn-primary py-1"><i class="fa-solid fa-floppy-disk"></i></button>
                    <a href="/users" class="btn btn-warning py-1"><i class="fa-solid fa-rotate-left"></i></a>
                </div>
            </form>
        </div>
    </div>
    <script>
        document.getElementById('avatar').addEventListener('change', function (event) {
            document.getElementById('img-avatar').src = URL.createObjectURL(event.target.files[0])
        })
    </script>
    <%- include('partials/footer') %>