<%- include('../partials/header') %>
    <div class="container">
        <div class="card text-left">
            <div class="card-header text-center">
                <h1>
                    <%=user%>
                </h1>
            </div>
            <form action="" method="post">

                <div class="card-body">
                    <div class="row mb-3">
                        <label for="title" class="col-sm-2 col-form-label">Title</label>
                        <div class="col-sm-10">
                            <input type="text" name="title" id="title" class="form-control"
                                placeholder="insert your title" value="<%=data.title%>" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="deadline" class="col-sm-2 col-form-label">Deadline</label>
                        <div class="col-sm-10">
                            <input type="datetime-local" name="deadline" id="deadline" class="form-control"
                                value="<%= moment(data.deadline).format('YYYY-MM-DDThh:mm') %>" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="complete" class="col-sm-2 col-form-label">Complete</label>
                        <div class="col-sm-10">
                            <input type="checkbox" id="complete" name="complete" <%=data.complete ? ' checked' : '' %>> done
                        </div>
                    </div>
                </div>
                <div class="card-footer text-body-secondary">
                    <button type="submit" class="btn btn-primary py-1"><i
                            class="fa-solid fa-floppy-disk"></i></button>
                    <a href="/users" class="btn btn-warning py-1"><i class="fa-solid fa-rotate-left"></i></a>
                </div>
            </form>
            <%- include('../partials/footer') %>