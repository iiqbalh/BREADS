<%- include('../partials/header') %>
    <div class="container">
        <div class="card text-left">
            <div class="card-header">
                <h3 class="float-start">
                    <%=user.email%>
                </h3>
                <a href="/logout" class="btn btn-secondary float-end"><i class="fa-solid fa-right-from-bracket"></i>
                    Sign Out</a>
            </div>
            <div class="card-header text-center">
                <h1>PostgreSQL BREADS(Browse, Read, Edit, Add, Delete, Sort)</h1>
            </div>
            <form action="" method="get">

                <input type="hidden" name="page" value="1">

                <div class="card-body">
                    <div class="row mb-3">
                        <label for="title" class="col-sm-2 col-form-label">Title</label>
                        <div class="col-sm-10">
                            <input type="text" name="title" id="title" class="form-control"
                                placeholder="insert your title" value="">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="deadline" class="col-sm-2 col-form-label">Deadline</label>
                        <div class="col-sm-4">
                            <input type="date" name="stardate" id="stardate" class="form-control" value="">
                        </div>
                        <div class="col-sm-2 text-center">
                            <p>s.d</p>
                        </div>
                        <div class="col-sm-4">
                            <input type="date" name="enddate" id="enddate" class="form-control" value="">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="complete" class="col-sm-2 col-form-label">Complete</label>
                        <div class="col-sm-10">
                            <select name="complete" id="complete" class="form-control">
                                <option disabled selected>-select complete-</option>
                                <option value="false">Not Yet</option>
                                <option value="true">Done</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="operation" class="col-sm-2 col-form-label">Operation</label>
                        <div class="col-sm-10">
                            <input type="radio" name="operation" value="or" checked>OR
                            <input type="radio" name="operation" value="and">AND

                        </div>
                    </div>

                    <button class="btn btn-info px-3 py-1" type="submit"><i
                            class="fa-solid fa-magnifying-glass"></i></button>
                    <a href="/" class="btn btn-warning px-3 py-1"><i class="fa-solid fa-rotate"></i></a>
                    <hr>
                </div>
            </form>

            <table id="data" class="table table-striped">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th><a href=""><i class="fa-solid fa-sort"></i>Title</a></th>
                        <th><a href=""><i class="fa-solid fa-sort"></i>Complete</a></th>
                        <th><a href=""><i class="fa-solid fa-sort"></i>Deadline</a></th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    <%data.forEach((item, index)=> {%>
                        <tr>
                            <td>
                                <%=index + 1%>
                            </td>
                            <td>
                                <%=item.title%>
                            </td>
                            <td>
                                <%=item.complete ? 'Done' : 'Not Yet' %>
                            </td>
                            <td>
                                <%= moment(item.deadline).locale('id').format('Do MMM YYYY LT') %>
                            </td>
                            <td>

                                <div class="modal" tabindex="-1" id="deleteModal">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Delete Confirmation</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>apakah kamu yakin akan menghapus data?
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <a class="btn btn-secondary px-4 py-1" href="">No</a>
                                                <button type="button" class="btn btn-warning px-4 py-1"
                                                    onclick="deleteData()">Yes</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <a class="btn btn-success py-1" href="users/update/<%=item.id%>"><i
                                        class="fa-solid fa-pen"></i></a>

                                <a class="btn btn-danger py-1" href="#" onclick="showDelele(`<%=item.id%>`)"><i
                                        class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>

                        <%})%>
                </tbody>
            </table>
            <div class="card-footer text-body-secondary">
                <a class="btn btn-primary px-4 py-1" href="users/add"><i class="fa-solid fa-plus"></i></a>

                <nav aria-label="Page navigation example" class="float-end">
        <ul class="pagination">
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
            </div>
        </div>
    </div>
    <%- include('../partials/footer') %>